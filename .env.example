# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/casus"

# NextAuth
NEXTAUTH_SECRET="generar-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# IA
ANTHROPIC_API_KEY="sk-ant-..."

# Mercado Pago (suscripciones)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# Cuentas sin límite de plan (lista de emails separados por coma), p. ej.
# cuentas internas del equipo. Opcional.
UNLIMITED_USER_EMAILS="tu-email@ejemplo.com"

# Integración con Google Drive/Sheets (Pro/Premium). Ver guía de
# configuración en Google Cloud Console en el README.
# Client ID/Secret: Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Clave de 32 bytes en base64 para cifrar los tokens de Google en la base de
# datos (nunca se guardan en texto plano). Generarla con:
#   openssl rand -base64 32
ENCRYPTION_KEY=""
